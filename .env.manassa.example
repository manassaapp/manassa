# ---------------------------------------------------------------------------
# Manassa (منصة) environment for docker-compose.manassa.yaml
# Copy to .env.manassa (or run: bash var/docker/manassa-init-env.sh) and fill
# in your own values. Never commit .env.manassa.
# ---------------------------------------------------------------------------

# ---- Addresses. Local values below; for production on https://manassa.space use:
#   MAIN_URL=https://manassa.space
#   FRONTEND_URL=https://manassa.space
#   NEXT_PUBLIC_BACKEND_URL=https://manassa.space/api
#   (and delete NOT_SECURED)
MANASSA_PORT=5300
MAIN_URL=http://127.0.0.1:5300
FRONTEND_URL=http://127.0.0.1:5300
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5300/api
# Plain http on localhost: allow non-secure cookies. Remove when served over https.
NOT_SECURED=true

# ---- Secrets generated locally by var/docker/manassa-init-env.sh
JWT_SECRET=
MANASSA_DB_PASSWORD=
MANASSA_TEMPORAL_DB_PASSWORD=

# ---- AGPL-3.0: public URL of THIS modified source code (shown in the footer).
# Required before you offer the app to other people over a network.
SOURCE_CODE_URL=

# ---- Registration
DISABLE_REGISTRATION=false

# ---- E-mail (optional; without it, accounts are activated without e-mail)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM_NAME=منصة
# EMAIL_FROM_ADDRESS=

# ---- Social platforms (paste your own app credentials)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- AI features (optional)
OPENAI_API_KEY=

# ---- Billing (optional; leave empty to disable billing)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=

API_LIMIT=30
